<header>
	<nav>
		<a class="purple_link" href="/"><h1><%= siteName %></h1></a>
		<form class="search-form" onsubmit="return searchGame(event)">
			<input
				type="text"
				id="searchInput"
				name="name"
				placeholder="Buscar juego..."
				required
			/>
			<button type="submit">
				<img class="icon" src="/img/search_icon.png" alt="Dislike" />
			</button>
		</form>
		<%- navBarItems %>
	</nav>
	<% if (showMessage) { %>
	<p>
		Bienvenido a <%= siteName %>, tu portal para conocer los mas reciente
		lanzamientos de juegos y compartir opiniones.
	</p>
	<% } %>
	<h2><%= subTitle %></h2>
</header>
