<div class="movie-card">
	<a href="/movie/<%= movie.id %>"
		><img src="<%= movie.image %>" alt="<%= movie.title %>"
	/></a>
	<a href="/movie/<%= movie.id %>"><h3><%= movie.title %></h3></a>
	<p>Género: <a href="/genre/<%= movie.genre %>"><%= movie.genre %></a></p>
	<p>Año: <a href="/year/<%= movie.year %>"><%= movie.year %></a></p>
</div>
