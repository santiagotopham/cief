<%- include('./templates/head') %>
<body>
    <header class="admin_header">
        <h1>Express Travels</h1>
        <nav>
            <%- menu %>
        </nav>
        
          </header>
          <main class="admin_main">
            
            <div class="insert">
                <h2>Formulario para añadir viajes</h2>
                <form action="/insert" method="post">
                    <div>
                        <label for="ruta">Ruta:</label>
                        <input type="text" id="ruta" name="ruta">
                    </div>
                    <div>
                        <label for="lugar">Lugar:</label>
                        <input type="text" id="lugar" name="lugar">
                    </div>
                    <div>
                        <label for="nombre">Nombre:</label>
                        <input type="text" id="nombre" name="nombre">
                    </div>
                    <div>
                        <label for="descripcion">Descripción:</label>
                        <input type="text" id="descripcion" name="descripcion">
                    </div>
                    <div>
                        <label for="precio">Precio:</label>
                        <input type="number" id="precio" name="precio" step="any">
                    </div>
                    <div>
                        <label for="imagen">Ruta de la imagen:</label>
                        <input type="text" id="imagen" name="img">
                    </div>
                    <div class="buttons">
                        <button type="submit">Añadir viaje</button>
                        <button type="reset">Borrar formulario</button>
                    </div>
                </form>
            </div>

            <div class="update">
                <h2>Formulario para modificar datos</h2>
                <form action="/update" method="post">
                    <input type="hidden" id="up_id" name="id">
                    <div>
                        <label for="up_ruta">Ruta:</label>
                        <input type="text" id="up_ruta" name="ruta">
                    </div>
                    <div>
                        <label for="up_lugar">Lugar:</label>
                        <input type="text" id="up_lugar" name="lugar">
                    </div>
                    <div>
                        <label for="up_nombre">Nombre:</label>
                        <input type="text" id="up_nombre" name="nombre">
                    </div>
                    <div>
                        <label for="up_descripcion">Descripción:</label>
                        <input type="text" id="up_descripcion" name="descripcion">
                    </div>
                    <div>
                        <label for="up_precio">Precio:</label>
                        <input type="number" id="up_precio" name="precio" step="any">
                    </div>
                    <div>
                        <label for="up_imagen">Ruta de la imagen:</label>
                        <input type="text" id="up_imagen" name="img">
                    </div>
                    <div class="buttons">
                        <button type="submit">Actualizar viaje</button>
                        <button type="reset">Borrar formulario</button>
                    </div>
                </form>
    </div>
    <!-- Tabla para mostrar todos los datos  -->
    <div class="admin_table">
        <table>
            <thead>
                <tr>
                    <th>Lugar</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% travels.forEach(travel => { %>
                    <tr>
                        <td><%= travel.lugar %></td>
                        <td><%= travel.nombre %></td>
                        <td><%= travel.descripcion %></td>
                        <td><%= parseFloat(travel.precio).toFixed(2) %> €</td>
                        <td>
                            <button onclick="mostrarFormularioActualizacion('<%= JSON.stringify(travel) %>')" title="Editar datos">
                                <svg xmlns="http://www.w3.org/2000/svg" 
                                width="16" 
                                height="16" 
                                
                                class="bi bi-pencil-fill" 
                                viewBox="0 0 16 16">
  <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
</svg>
                            </button>
                        </td>
                        <td>
                            <button onclick="eliminarTravel('<%= travel.id %>')" title="Borrar viaje">
                                <svg xmlns="http://www.w3.org/2000/svg" 
                                width="16" 
                                height="16" 
                                fill="currentColor" 
                                class="bi bi-trash-fill" 
                                viewBox="0 0 16 16">
  <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
</svg>
                            </button>
                            
</td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</main>
        
</body>
</html>