<div class="member-card">
	<a href="/member/<%= member.id %>"
		><img src="img_team/<%= member.foto %>" alt="<%= member.name %>"
	/></a>
	<a href="/member/<%= member.id %>"><h3><%= member.name %></h3></a>
	<p>
		Departamento:
		<a href="/department/<%= member.department %>"
			><%= member.department %></a
		>
	</p>
	<p>Email: <%= member.email %></p>
</div>
